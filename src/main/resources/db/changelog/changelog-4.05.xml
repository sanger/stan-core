<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="4.5.0" author="dr6">
        <createTable tableName="work_type_link">
            <column name="work_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_work_id" referencedTableName="work" referencedColumnNames="id"/>
            </column>
            <column name="work_type_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_work_type_id" referencedTableName="work_type" referencedColumnNames="id"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="work_type_link" columnNames="work_id,work_type_id"/>

        <dropForeignKeyConstraint baseTableName="work" constraintName="fk_work_work_type"/>
        <dropColumn tableName="work" columnName="work_type_id"/>
    </changeSet>

</databaseChangeLog>
